<style>
.root { width: 580px; flex-direction: column; gap: 12px; padding: 20px; border-radius: 22px; background-color: #101320; border-width: 1px; border-color: #435060; }
.brand { color: #74e2ed; font-size: 16px; }
.title { color: #ffe651; font-size: 32px; }
.copy { padding: 14px; background-color: #1a2131; border-radius: 12px; color: #f5f4fa; font-size: 22px; }
.row { flex-direction: row; gap: 6px; align-items: center; }
.tab { border-radius: 14px; border-width: 2px; }
.exit { background-color: #20293b; border-color: #74e2ed; border-width: 1px; }
.body { flex-direction: row; gap: 14px; }
.data { flex-direction: column; flex-grow: 1; flex-basis: 0; gap: 6px; }
.field { flex-direction: column; padding: 8px; border-radius: 8px; background-color: #1a2131; }
.key { font-size: 16px; color: #8adee6; }
.value { font-size: 22px; color: #f7f6fa; }
.photo { width: 175px; height: 175px; border-radius: 14px; border-color: #68747b; border-width: 1px; }
</style>
<Panel class="root">
  <div id="machine" class="brand">SENAI X-RAY</div>
  <div id="title" class="title">Informações</div>
  <div class="body"><div class="data"><div id="field0" class="field"><div class="key" id="key0">Campo</div><div class="value" id="val0">Valor</div></div><Button id="route0"><ButtonLabel>Procedimento</ButtonLabel></Button>
<div id="field1" class="field"><div class="key" id="key1">Campo</div><div class="value" id="val1">Valor</div></div><Button id="route1"><ButtonLabel>Procedimento</ButtonLabel></Button>
<div id="field2" class="field"><div class="key" id="key2">Campo</div><div class="value" id="val2">Valor</div></div><Button id="route2"><ButtonLabel>Procedimento</ButtonLabel></Button>
    <div id="copy" class="copy">Ficha demonstrativa</div>
  </div><img id="photo" class="photo" src="/printer-outline.svg" /></div>

  <Button id="routes"><ButtonLabel>Todos os procedimentos</ButtonLabel></Button>
  <Button id="action0"><ButtonLabel>Resposta A</ButtonLabel></Button>
  <Button id="action1"><ButtonLabel>Resposta B</ButtonLabel></Button>
  <div class="row">
    <Button id="action2"><ButtonLabel>Anterior</ButtonLabel></Button>
    <Button id="action3"><ButtonLabel>Próximo</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="action4"><ButtonLabel>Fechar ficha</ButtonLabel></Button>
    <Button id="action5"><ButtonLabel>Reposicionar</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="tab0" class="tab"><ButtonLabel>Informações</ButtonLabel></Button>
    <Button id="tab1" class="tab"><ButtonLabel>Diagnóstico</ButtonLabel></Button>
    <Button id="tab2" class="tab"><ButtonLabel>Manutenções</ButtonLabel></Button>
  </div>
  <Button id="exit" class="exit"><ButtonLabel>Voltar ao navegador</ButtonLabel></Button>
</Panel>
