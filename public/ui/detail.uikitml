<style>
.root { width: 520px; flex-direction: column; gap: 12px; padding: 20px; border-radius: 22px; background-color: #101320; border-width: 1px; border-color: #435060; }
.brand { color: #74e2ed; font-size: 16px; }
.title { color: #ffe651; font-size: 32px; }
.copy { padding: 14px; background-color: #1a2131; border-radius: 12px; color: #f5f4fa; font-size: 22px; }
.row { flex-direction: row; gap: 6px; align-items: center; }
.tab { border-radius: 14px; border-width: 2px; }
.exit { background-color: #20293b; border-color: #74e2ed; border-width: 1px; }
</style>
<Panel class="root">
  <div class="brand">SENAI X-RAY   /   LABORATÓRIO</div>
  <div id="title" class="title">Equipamento</div>
  <div class="row">
    <Button id="tab0" class="tab"><ButtonLabel>Informações</ButtonLabel></Button>
    <Button id="tab1" class="tab"><ButtonLabel>Diagnóstico</ButtonLabel></Button>
    <Button id="tab2" class="tab"><ButtonLabel>Manutenção</ButtonLabel></Button>
  </div>
  <div id="copy" class="copy">Ficha demonstrativa</div>
  <Button id="action0"><ButtonLabel>Resposta A</ButtonLabel></Button>
  <Button id="action1"><ButtonLabel>Resposta B</ButtonLabel></Button>
  <div class="row">
    <Button id="action2"><ButtonLabel>Anterior</ButtonLabel></Button>
    <Button id="action3"><ButtonLabel>Próximo</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="action4"><ButtonLabel>Fechar ficha</ButtonLabel></Button>
    <Button id="action5"><ButtonLabel>Reposicionar</ButtonLabel></Button>
  </div>
  <Button id="exit" class="exit"><ButtonLabel>Voltar ao navegador</ButtonLabel></Button>
</Panel>
