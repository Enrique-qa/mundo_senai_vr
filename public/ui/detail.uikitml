<style>
.root { width: 490px; padding: 20px; gap: 10px; flex-direction: column; background-color: #141825; }
.eyebrow { font-size: 15px; color: #80e2eb; }
.title { font-size: 28px; color: #ffda50; }
.copy { font-size: 22px; color: #ffffff; }
.row { flex-direction: row; gap: 6px; }
</style>
<Panel class="root">
